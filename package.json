{
  "name": "@marks/pi-subagent",
  "version": "0.1.0",
  "description": "Minimal Pi extension: one subagent tool that spawns role-shaped child pi processes. Roles defined as markdown in ~/.pi/agent/agents/.",
  "type": "module",
  "main": "src/index.ts",
  "license": "MIT",
  "author": "Mark Hougaard <mark@hougaard.email>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markhougaard/pi-subagent.git"
  },
  "bugs": {
    "url": "https://github.com/markhougaard/pi-subagent/issues"
  },
  "homepage": "https://github.com/markhougaard/pi-subagent#readme",
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "pi",
    "subagent",
    "pi-package",
    "agent",
    "llm"
  ],
  "files": [
    "src",
    "agents",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "node --experimental-strip-types --test 'src/**/*.test.js'",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@sinclair/typebox": "*"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
